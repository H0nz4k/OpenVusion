[Unit]
Description=OpenVusion HWSniff field collector
After=local-fs.target
Wants=local-fs.target

[Service]
Type=simple
User=hwsniff
Group=hwsniff
# DRM/KMS + serial + touch need these groups even under systemd.
SupplementaryGroups=dialout video render input
WorkingDirectory=/opt/Sniff
Environment=PYTHONUNBUFFERED=1
# Prefer KMS/DRM for Waveshare without a full desktop. Override in
# /etc/hwsniff/display.env if needed (e.g. SDL_VIDEODRIVER=x11).
Environment=SDL_VIDEODRIVER=kmsdrm
EnvironmentFile=-/etc/hwsniff/display.env
ExecStart=/opt/Sniff/.venv/bin/python -m hwsniff --config /etc/hwsniff/config.json
# on-failure: covers crash + intentional chord restart (exit 75).
Restart=on-failure
RestartSec=3
TimeoutStopSec=40
KillSignal=SIGTERM

RuntimeDirectory=hwsniff
StateDirectory=hwsniff
LogsDirectory=hwsniff

[Install]
WantedBy=multi-user.target
