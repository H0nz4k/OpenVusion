[Unit]
Description=OpenVusion HWSniff v2 (Pi Zero 2 W headless GPIO)
Documentation=file:///opt/Sniff/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hwsniff
Group=hwsniff
# Writable runtime dir — lgpio needs notify pipes here (not under /opt/Sniff).
WorkingDirectory=/var/lib/hwsniff
Environment=PYTHONUNBUFFERED=1
Environment=HOME=/var/lib/hwsniff
ExecStart=/opt/Sniff/.venv/bin/python -m hwsniff --config /etc/hwsniff/config.json
Restart=on-failure
RestartSec=2
# GPIO via gpio group; TWN4 USB serial via dialout
SupplementaryGroups=gpio dialout

[Install]
WantedBy=multi-user.target
